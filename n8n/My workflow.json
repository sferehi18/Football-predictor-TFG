    {
      "parameters": {
        "jsCode": "const rows = [];\nlet header = null;\n\nfor (const item of $input.all()) {\n  const csv = item.json.body || item.json.data;\n  if (!csv) continue;\n\n  const lines = csv.split(\"\\n\").filter(l => l.trim() !== \"\");\n\n  if (!header) {\n    header = lines[0];\n  }\n\n  rows.push(...lines.slice(1));\n}\n\nconst columns = header.split(\",\");\n\nconst dateIndex = columns.indexOf(\"Date\");\nconst timeIndex = columns.indexOf(\"Time\");\n\nfunction parseDate(line) {\n  const cols = line.split(\",\");\n\n  const [day, month, year] = cols[dateIndex].split(\"/\");\n  const time = cols[timeIndex] || \"00:00\";\n\n  return new Date(`${year}-${month}-${day}T${time}:00`).getTime();\n}\n\nrows.sort((a, b) => parseDate(a) - parseDate(b));\n\nconst finalCsv = [header, ...rows].join(\"\\n\");\n\nreturn [\n  {\n    binary: {\n      data: {\n        data: Buffer.from(finalCsv).toString(\"base64\"),\n        mimeType: \"text/csv\",\n        fileName: \"merged_sorted.csv\"\n      }\n    }\n  }\n];"
      },
