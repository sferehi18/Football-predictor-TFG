    {
      "parameters": {
        "jsCode": "const enlaces = $input.first().json.enlaces || [];\n\nreturn enlaces\n  .filter(l => {\n    if (!l.includes(\"SP1.csv\")) return false;\n\n    const match = l.match(/\\/(\\d{4})\\/SP1\\.csv$/);\n    if (!match) return false;\n\n    // ❌ excluir temporadas que empiezan por 9 (90s)\n    if (match[1].startsWith(\"9\")) return false;\n\n    const season = parseInt(match[1], 10);\n\n    return season >= 1920;\n  })\n  .map(l => ({\n    json: {\n      url: \"https://www.football-data.co.uk/\" + l\n    }\n  }));"
      },
