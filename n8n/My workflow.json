        "jsCode": "const binaries = $input.first().binary;\n\nconst nombresPermitidos = [\n  \"clubs.csv\",\n  \"game_lineups.csv\",\n  \"players.csv\",\n  \"player_valuations.csv\",\n  \"games.csv\",\n  \"appearances.csv\"\n];\n\nconst output = [];\n\nfor (const key of Object.keys(binaries)) {\n  const file = binaries[key];\n\n  // comprobar nombre exacto\n  if (nombresPermitidos.includes(file.fileName)) {\n    output.push({\n      binary: {\n        data: file\n      }\n    });\n  }\n}\n\nreturn output;"
      },
